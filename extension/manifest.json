{
  "manifest_version": 3,
  "name": "B站活动筛选助手",
  "version": "1.0.0",
  "description": "在B站活动列表页注入筛选工具栏，智能匹配适合你的投稿活动，实时显示剩余时间和奖励信息",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/blackboard/era/reward-activity-list-page.html*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "B站活动筛选助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://www.bilibili.com/*"]
    }
  ]
}
