{
  "name": "bilibili-activity-filter",
  "version": "1.1.7",
  "description": "B站活动筛选工具 - 实时获取B站投稿活动数据",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "start": "node server.js",
    "dev": "node server.js",
    "pack": "npm run build && node scripts/pack.js",
    "release": "npm version patch --no-git-tag-version && npm run pack",
    "update-data": "node scripts/update-data.js"
  },
  "keywords": [
    "bilibili",
    "activity",
    "filter"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "archiver": "^7.0.1"
  }
}
